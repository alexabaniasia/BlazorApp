@page "/register"
@layout PlainLayout
@inject NavigationManager Navigation
@inject AppStateService AppState

<PageTitle>Create account — Spending Log</PageTitle>

<div class="auth-page">
    <button class="menu-toggle" title="Toggle panel" @onclick="ToggleSidebar">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 3H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <path d="M1 8H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <path d="M1 13H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
    </button>

    @if (!sidebarCollapsed)
    {
        <aside class="auth-sidebar">
            <p class="eyebrow">Spending log</p>
            <h1 class="pitch">Track every dollar, clearly.</h1>

            <div class="preview-list">
                @foreach (var expense in AppState.Expenses.Take(3))
                {
                    <div class="preview-row">
                        <span>@expense.Item</span>
                        <span class="preview-cost">@expense.Cost.ToString("$0.00")</span>
                    </div>
                }
                <div class="preview-row preview-total">
                    <span>Total</span>
                    <span class="preview-cost">@AppState.Total.ToString("$#,##0.00")</span>
                </div>
            </div>
        </aside>
    }

    <main class="flex flex-1 items-center justify-center bg-[#120c19] p-10">
        <div class="w-full max-w-sm">
            <p class="mb-2.5 text-[0.7rem] uppercase tracking-[0.18em] text-[#b09fc9]">Spending log</p>
            <h2 class="mb-8 mt-1 text-[2rem] font-bold text-white">Create account</h2>

            <EditForm Model="@model" OnSubmit="HandleRegister">
                <div class="mb-5">
                    <label class="@LabelClass">Full name</label>
                    <InputText class="@InputClass" @bind-Value="model.FullName" placeholder="Jane Smith" />
                </div>
                <div class="mb-5">
                    <label class="@LabelClass">Username</label>
                    <InputText class="@InputClass" @bind-Value="model.Username" placeholder="your_username" />
                </div>
                <div class="mb-5">
                    <label class="@LabelClass">Password</label>
                    <InputText class="@InputClass" type="password" @bind-Value="model.Password" placeholder="Min. 6 characters" />
                </div>
                <div class="mb-5">
                    <label class="@LabelClass">Confirm password</label>
                    <InputText class="@InputClass" type="password" @bind-Value="model.ConfirmPassword" placeholder="••••••••" />
                </div>
                <button type="submit" class="@ButtonClass">Create account</button>
            </EditForm>

            <p class="mt-5 text-center text-[0.82rem] text-[#9285a3]">
                Already have an account? <a class="text-[#b9a6e0] underline" href="/login">Sign in</a>
            </p>
        </div>
    </main>
</div>

@code {
    private const string LabelClass = "mb-2 block text-[0.68rem] uppercase tracking-[0.14em] text-[#a996d1]";
    private const string InputClass = "w-full rounded-lg border border-[#362a44] bg-[#1c1524] px-3.5 py-3 text-sm text-[#f2eef7] placeholder:text-[#5f5670] focus:border-[#e8794f] focus:outline-none";
    private const string ButtonClass = "mt-2 w-full cursor-pointer rounded-lg bg-[#ee8e63] py-[13px] text-[0.95rem] font-bold text-[#1a1020] transition-colors hover:bg-[#f2a67e]";

    private RegisterModel model = new();
    private bool sidebarCollapsed = true;

    private void ToggleSidebar() => sidebarCollapsed = !sidebarCollapsed;

    private void HandleRegister()
    {
        var displayName = string.IsNullOrWhiteSpace(model.Username) ? model.FullName : model.Username;
        AppState.Login(model.Username, displayName);
        Navigation.NavigateTo("/dashboard");
    }
}
