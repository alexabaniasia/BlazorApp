@page "/dashboard"
@page "/"
@layout MainLayout
@inject NavigationManager Navigation
@inject AppStateService AppState
@implements IDisposable

<PageTitle>Dashboard — Spending Log</PageTitle>

<div class="px-6 pb-16 pt-16 md:px-12 md:pt-10">
    <header class="flex items-start justify-between border-b border-[#e1dee6] pb-5">
        <div>
            <p class="@EyebrowClass">Spending log</p>
            <h1 class="text-[2rem] font-bold text-[#16101d]">Dashboard</h1>
        </div>
        <div class="flex items-center gap-6">
            <div class="text-right">
                <p class="@EyebrowClass">Total</p>
                <p class="text-[1.7rem] font-bold text-[#e8794f]">@AppState.Total.ToString("$#,##0.00")</p>
            </div>
            <button class="cursor-pointer rounded-md border border-[#c9c3d3] px-4 py-2 text-[0.72rem] uppercase tracking-[0.08em] text-[#4a4056] transition-colors hover:bg-[#ece9f0]"
                    @onclick="SignOut">
                Sign out
            </button>
        </div>
    </header>

    <section class="my-7 flex max-w-[720px] items-end gap-4">
        <div class="flex flex-1 flex-col">
            <label class="@LabelClass">Item</label>
            <input class="@InputClass" placeholder="e.g. Team lunch" @bind="newItem" @bind:event="oninput" />
        </div>
        <div class="flex flex-col">
            <label class="@LabelClass">Cost ($)</label>
            <input class="@InputClass" type="number" min="0" step="0.01" placeholder="0.00" @bind="newCost" @bind:event="oninput" />
        </div>
        <button class="cursor-pointer rounded-md bg-[#2f1c3d] px-6 py-[11px] text-[0.85rem] font-semibold text-white transition-colors hover:bg-[#402854]"
                @onclick="AddExpense">
            Add
        </button>
    </section>

    <div class="overflow-x-auto">
        <table class="w-full max-w-[960px] border-collapse">
            <thead>
                <tr>
                    <th class="@ThClass">Item</th>
                    <th class="@ThClass">Date</th>
                    <th class="@ThClass text-right">Cost</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var expense in AppState.Expenses)
                {
                    <tr>
                        <td class="border-b border-[#eae7ee] py-4 text-[0.88rem] font-semibold text-[#16101d]">@expense.Item</td>
                        <td class="border-b border-[#eae7ee] py-4 text-[0.88rem] text-[#8a7f9c]">@expense.Date.ToString("MMM d")</td>
                        <td class="border-b border-[#eae7ee] py-4 text-right text-[0.88rem] font-semibold text-[#16101d]">@expense.Cost.ToString("$0.00")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td class="border-t-2 border-[#16101d] pt-[18px] text-[0.72rem] font-bold uppercase tracking-[0.08em] text-[#16101d]">
                        Total — @AppState.Expenses.Count items
                    </td>
                    <td class="border-t-2 border-[#16101d]"></td>
                    <td class="border-t-2 border-[#16101d] pt-[18px] text-right text-[1.15rem] font-bold text-[#e8794f]">
                        @AppState.Total.ToString("$#,##0.00")
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@code {
    private const string EyebrowClass = "mb-1.5 text-[0.68rem] uppercase tracking-[0.16em] text-[#7a6f91]";
    private const string LabelClass = "mb-1.5 text-[0.65rem] uppercase tracking-[0.1em] text-[#7a6f91]";
    private const string InputClass = "w-full rounded-md border border-[#dad5e1] bg-[#e9e6ee] px-3.5 py-[11px] text-[0.88rem] text-[#16101d] placeholder:text-[#a49cb0] focus:border-[#8f7fb3] focus:outline-none";
    private const string ThClass = "border-b border-[#d9d5e0] py-2.5 text-left text-[0.65rem] font-medium uppercase tracking-[0.1em] text-[#7a6f91]";

    private string newItem = string.Empty;
    private string newCost = string.Empty;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;

        if (AppState.CurrentUser is null || !AppState.CurrentUser.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void AddExpense()
    {
        if (decimal.TryParse(newCost, out var cost))
        {
            AppState.AddExpense(newItem, cost);
        }

        newItem = string.Empty;
        newCost = string.Empty;
    }

    private void SignOut()
    {
        AppState.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
