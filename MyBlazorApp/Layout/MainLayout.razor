@inherits LayoutComponentBase

<div class="flex h-screen bg-[#f6f5f8] font-mono text-[#1c1522]">
    <!-- Sidebar -->
    <div class="w-64 bg-[#120c19] text-[#f2eef7] flex-shrink-0 border-r border-[#362a44]">
        <NavMenu />
    </div>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col overflow-y-auto">
        <!-- Top Bar -->
        <div class="h-14 flex items-center justify-end px-6 bg-white border-b border-[#e1dee6]">
            <a class="text-sm font-medium text-[#8a7f9c] transition-colors hover:text-[#e8794f]" href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <!-- Page Content -->
        <article class="flex-1">
            @Body
        </article>
    </main>
</div>