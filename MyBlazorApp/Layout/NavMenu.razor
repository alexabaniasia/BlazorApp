<button title="Toggle navigation"
        class="fixed left-4 top-4 z-30 flex h-10 w-10 items-center justify-center rounded-md border border-[#e8794f] bg-[#170d1f] text-[#e8794f] md:hidden"
        @onclick="ToggleMenu">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 3H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <path d="M1 8H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <path d="M1 13H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
</button>

<aside class="@SidebarClass">
    <div class="px-6 pb-8 pt-10">
        <p class="mb-2.5 text-[0.7rem] uppercase tracking-[0.18em] text-[#b09fc9]">Spending log</p>
        <p class="text-xl font-bold leading-tight text-white">Track every dollar, clearly.</p>
    </div>

    <nav class="flex flex-col gap-1 px-3" @onclick="CloseMenu">
        <NavLink class="@LinkClass" ActiveClass="@ActiveLinkClass" href="dashboard">Dashboard</NavLink>
        <NavLink class="@LinkClass" ActiveClass="@ActiveLinkClass" href="feedback">Feedback</NavLink>
        <NavLink class="@LinkClass" ActiveClass="@ActiveLinkClass" href="counter">Counter</NavLink>
        <NavLink class="@LinkClass" ActiveClass="@ActiveLinkClass" href="weather">Weather</NavLink>
    </nav>
</aside>

@code {
    private const string LinkClass = "rounded-md px-3 py-2.5 text-sm text-[#b09fc9] transition-colors hover:bg-white/5 hover:text-white";
    private const string ActiveLinkClass = "bg-[#e8794f]/[0.15] text-white";

    private bool open;

    private string SidebarClass =>
        "fixed inset-y-0 left-0 z-20 w-60 shrink-0 bg-gradient-to-b from-[#3a1f4d] via-[#2c1738] to-[#170d1f] " +
        "transition-transform md:static md:translate-x-0 " +
        (open ? "translate-x-0" : "-translate-x-full");

    private void ToggleMenu() => open = !open;
    private void CloseMenu() => open = false;
}